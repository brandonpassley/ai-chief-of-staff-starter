{
  "mcpServers": {
    "_comment": "MCP server config. Copy this file to .mcp.json (drop the .example) and edit. JSON does not support real comments — see context/integrations/ for per-tool setup guides.",

    "_example_notion": {
      "_description": "Notion MCP — connects Claude to your Notion databases. Get an integration token at notion.so/my-integrations, then share specific pages with the integration.",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer YOUR_TOKEN_HERE\", \"Notion-Version\": \"2025-09-03\"}"
      }
    },

    "_example_slack": {
      "_description": "Slack MCP — lets Claude post to your channels. Create a Slack app at api.slack.com/apps with the bot scopes you need.",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-...",
        "SLACK_TEAM_ID": "T..."
      }
    }
  }
}
